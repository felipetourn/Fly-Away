# Copiar a .env y completar. NUNCA commitear .env
SECRET_KEY=cambiar-esto
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase > Project Settings > Database > Connection string (URI).
# Para Render usar el "Session pooler" (IPv4). Vacío = SQLite local.
DATABASE_URL=

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=

# Email: con BREVO_API_KEY sale por la API de Brevo (lo que usa Render); sin ella, se imprime en consola.
# DEFAULT_FROM_EMAIL tiene que ser un remitente verificado en la cuenta de Brevo.
# BREVO_API_KEY=
# SMTP (no anda en Render free):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_TIMEOUT=5
# DEFAULT_FROM_EMAIL=Fly Away <no-reply@flyaway.com>

# Mercado Pago: Access Token de prueba de la aplicación (developers.mercadopago.com > Tus integraciones).
# Vacío = el pago con MP responde "No pudimos conectar con Mercado Pago".
MP_ACCESS_TOKEN=
# Adonde vuelve el comprador después del checkout de MP.
FRONTEND_URL=http://localhost:5173
